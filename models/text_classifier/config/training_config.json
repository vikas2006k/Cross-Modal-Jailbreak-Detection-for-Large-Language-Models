{
  "model_name": "distilbert-base-uncased",
  "num_labels": 2,
  "max_length": 128,
  "batch_size": 16,
  "epochs": 10,
  "learning_rate": 2e-5,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "seed": 42,
  "evaluation_strategy": "epoch",
  "save_strategy": "epoch",
  "save_total_limit": 3,
  "metric_for_best_model": "f1",
  "load_best_model_at_end": true,
  "early_stopping_patience": 2,
  "output_dir": "models/text_classifier/checkpoints",
  "best_model_dir": "models/text_classifier/best_model",
  "tokenizer_dir": "models/text_classifier/tokenizer",
  "logging_dir": "models/text_classifier/logs"
}
